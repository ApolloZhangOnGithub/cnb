#!/usr/bin/env python3
"""dispatcher — Session keepalive + health monitoring daemon.

Concerns (each with independent check intervals):
  CoralManager       — dispatcher Claude session lifecycle
  SessionKeepAlive   — detect dead dev sessions
  IdleDetector       — batch screen snapshot comparison
  IdleKiller         — kill sessions idle >30min
  NudgeCoordinator   — unified nudge orchestrator (inbox/queued/idle)
  ProductionLineIntake — keep manager task stack fed from GitHub issues
  ManagerCloseoutEscalator — escalate manager tasks stuck after workers finish
  CoralPoker         — periodic heartbeat to dispatcher session
  HealthChecker      — periodic full status report + team idle detection
  BugSLAChecker      — check overdue bugs
  ResourceMonitor    — battery/memory/CPU
  TimeAnnouncer      — hourly/daily announcements
  AdaptiveThrottle   — slow down main loop when CPU is high
"""

import os
import signal
import sys
import time
from pathlib import Path

_self = Path(__file__).resolve()
CLAUDES_HOME = _self.parent.parent
sys.path.insert(0, str(CLAUDES_HOME))

# Watched paths for the auto-reload check: changes here mean a fresh process
# must pick up the new code (see issue #235). lib/blog_* etc. is intentionally
# excluded — those modules are not imported by dispatcher.
WATCHED_PATHS = (
    CLAUDES_HOME / "lib" / "concerns",
    CLAUDES_HOME / "bin" / "dispatcher",
    CLAUDES_HOME / "bin" / "dispatcher-watchdog",
)
RELOAD_DEBOUNCE_SECONDS = 5

from lib.common import ClaudesEnv
from lib.concerns import (
    AdaptiveThrottle,
    BugSLAChecker,
    Concern,
    CoralManager,
    CoralPoker,
    DispatcherConfig,
    HealthChecker,
    IdleDetector,
    IdleKiller,
    ManagerCloseoutEscalator,
    NudgeCoordinator,
    ProductionLineIntake,
    ResourceMonitor,
    SessionKeepAlive,
    TimeAnnouncer,
    log,
    tmux_ok,
)

# ---------------------------------------------------------------------------
# Configuration
# ---------------------------------------------------------------------------

env = ClaudesEnv.load()
DISPATCHER_SESSION = os.environ.get("DISPATCHER_SESSION", "dispatcher")

cfg = DispatcherConfig(
    prefix=env.prefix,
    project_root=env.project_root,
    claudes_dir=env.claudes_dir,
    sessions_dir=env.sessions_dir,
    board_db=env.board_db,
    suspended_file=env.suspended_file,
    board_sh=str(CLAUDES_HOME / "bin" / "board"),
    coral_sess=f"{env.prefix}-{DISPATCHER_SESSION}",
    dispatcher_session=DISPATCHER_SESSION,
    log_dir=env.claudes_dir / "logs",
    okr_dir=env.claudes_dir / "okr",
    dev_sessions=sorted(sf.stem for sf in env.sessions_dir.glob("*.md") if sf.stem != "dispatcher"),
)

cfg.log_dir.mkdir(parents=True, exist_ok=True)

for _p in [cfg.sessions_dir, cfg.claudes_dir]:
    if not _p.exists():
        print(f"FATAL: missing {_p}", file=sys.stderr)
        sys.exit(1)
if not Path(cfg.board_sh).exists():
    print(f"FATAL: missing {cfg.board_sh}", file=sys.stderr)
    sys.exit(1)


# ---------------------------------------------------------------------------
# Main loop
# ---------------------------------------------------------------------------


def _max_mtime(paths: tuple[Path, ...]) -> float:
    """Return the max mtime across all .py files under watched paths.

    Files that have been removed or are unreadable are skipped silently — the
    check is best-effort and must never block dispatcher startup.
    """
    latest = 0.0
    for root in paths:
        if root.is_file():
            try:
                latest = max(latest, root.stat().st_mtime)
            except OSError:
                continue
            continue
        if not root.is_dir():
            continue
        for py in root.rglob("*.py"):
            try:
                latest = max(latest, py.stat().st_mtime)
            except OSError:
                continue
    return latest


def _code_changed(baseline_mtime: float, sleep=time.sleep) -> bool:
    """Detect a watched-path mtime newer than baseline, debouncing mid-save.

    On first detection, sleeps RELOAD_DEBOUNCE_SECONDS and re-reads. Returns
    True only if the change is still present after the debounce — protects
    against half-written files (editor swap-file flicker, partial git checkout).
    The sleep callable is injectable for tests.
    """
    if _max_mtime(WATCHED_PATHS) <= baseline_mtime:
        return False
    sleep(RELOAD_DEBOUNCE_SECONDS)
    return _max_mtime(WATCHED_PATHS) > baseline_mtime


def _acquire_pidlock() -> Path:
    pidfile = cfg.claudes_dir / "dispatcher.pid"
    if pidfile.exists():
        try:
            old_pid = int(pidfile.read_text().strip())
            os.kill(old_pid, 0)
            print(f"FATAL: dispatcher already running (pid {old_pid})", file=sys.stderr)
            sys.exit(1)
        except (ValueError, ProcessLookupError, PermissionError):
            pass
    pidfile.write_text(str(os.getpid()))
    return pidfile


def main() -> None:
    pidfile = _acquire_pidlock()
    base_interval = 2
    baseline_mtime = _max_mtime(WATCHED_PATHS)

    coral = CoralManager(cfg)
    idle = IdleDetector(cfg)
    poker = CoralPoker(cfg)
    nudge = NudgeCoordinator(cfg, idle)
    throttle = AdaptiveThrottle()
    # Order matters: idle must tick before idle_killer / nudge_coordinator
    concerns: list[Concern] = [
        coral,
        TimeAnnouncer(cfg),
        idle,
        SessionKeepAlive(cfg),
        IdleKiller(cfg, idle, coral),
        nudge,
        ProductionLineIntake(cfg),
        ManagerCloseoutEscalator(cfg),
        poker,
        BugSLAChecker(cfg, poker),
        HealthChecker(cfg, poker, coral),
        ResourceMonitor(cfg),
        throttle,
    ]

    log(f"Starting (base_interval:{base_interval}s concerns:{len(concerns)})")
    log("Ctrl-C to stop")

    running = True

    def _shutdown(signum, frame):
        nonlocal running
        running = False

    signal.signal(signal.SIGINT, _shutdown)
    signal.signal(signal.SIGTERM, _shutdown)

    try:
        while running:
            now = int(time.time())

            any_alive = any(tmux_ok("has-session", "-t", f"{cfg.prefix}-{s}") for s in cfg.dev_sessions)
            if not any_alive:
                log("No dev sessions alive. Shutting down.")
                break

            for c in concerns:
                c.maybe_tick(now)

            if _code_changed(baseline_mtime):
                log("Code change detected in watched paths, exiting for watchdog restart")
                raise SystemExit(0)

            deadline = time.time() + base_interval * throttle.multiplier
            while running and time.time() < deadline:
                time.sleep(min(0.5, max(0, deadline - time.time())))
    finally:
        log("Shutting down...")
        pidfile.unlink(missing_ok=True)
        log("Stopped.")


if __name__ == "__main__":
    main()
